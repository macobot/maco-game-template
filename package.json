{
  "name": "@macobot/maco-game-template",
  "version": "0.1.5",
  "description": "Template for independently released Maco browser games.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macobot/maco-game-template.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "files": [
    "bin",
    "scripts",
    "src",
    "README.md"
  ],
  "bin": {
    "maco": "./bin/maco.mjs"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "publish": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish --access public --ignore-scripts"
  },
  "devDependencies": {
    "changelogen": "^0.6.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "bugs": {
    "url": "https://github.com/macobot/maco-game-template/issues"
  },
  "homepage": "https://github.com/macobot/maco-game-template#readme"
}

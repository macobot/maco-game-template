{
  "name": "@macobot/maco-game-template",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Template for Maco browser games shipped as iframe upload kits.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macobot/maco-game-template.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "maco": {
    "key": "my-game"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src scripts",
    "maco:validate": "node scripts/zip-maco.mjs --validate",
    "maco:zip": "node scripts/zip-maco.mjs",
    "maco:publish": "pnpm typecheck && pnpm test && pnpm build && pnpm maco:zip"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "javascript-obfuscator": "^5.9.1",
    "rollup-plugin-obfuscator": "^1.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "3.2.7",
    "yazl": "3.3.1"
  },
  "bugs": {
    "url": "https://github.com/macobot/maco-game-template/issues"
  },
  "homepage": "https://github.com/macobot/maco-game-template#readme"
}

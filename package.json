{
  "name": "@macobot/maco-game-template",
  "version": "0.1.3",
  "description": "Template for independently released Maco browser games.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macobot/maco-game-template.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/main.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "maco:init": "node scripts/init-maco.mjs",
    "maco:handoff": "node scripts/handoff-maco.mjs",
    "maco:publish": "node scripts/publish-maco.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "bugs": {
    "url": "https://github.com/macobot/maco-game-template/issues"
  },
  "homepage": "https://github.com/macobot/maco-game-template#readme"
}

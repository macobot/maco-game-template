{
  "name": "@lukhaiminh/maco-game-package-template",
  "version": "0.1.0",
  "description": "Template for independently released Maco browser games.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukhaiminh/maco-game-package-template.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.20.0",

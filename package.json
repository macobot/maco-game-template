{
  "name": "@macobot/maco-game-template",
  "version": "0.2.0",
  "description": "Template for Maco browser games shipped as iframe upload kits.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macobot/maco-game-template.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "maco": {
    "key": "my-game"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "maco:zip": "node scripts/zip-maco.mjs"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "3.2.7",
    "yazl": "3.3.1"
  },
  "bugs": {
    "url": "https://github.com/macobot/maco-game-template/issues"
  },
  "homepage": "https://github.com/macobot/maco-game-template#readme"
}

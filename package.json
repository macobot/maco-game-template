{
  "name": "@macobot/maco-cli",
  "version": "0.2.5",
  "description": "CLI for validating and packaging Maco iframe game upload kits.",
  "keywords": [
    "maco",
    "maco-games",
    "game",
    "cli",
    "iframe"
  ],
  "bin": {
    "maco": "./bin/maco.mjs"
  },
  "files": [
    "bin",
    "bridge/maco-bridge.js",
    "scripts/zip-maco.mjs",
    "scripts/handoff-maco.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macobot/maco-game-template.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "maco": {
    "key": "my-game"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src scripts",
    "maco:validate": "maco validate",
    "maco:zip": "maco zip",
    "maco:publish": "maco publish",
    "playground:maco:setup": "pnpm --dir playground exec maco setup",
    "playground:maco:validate": "node scripts/run-playground.mjs maco:validate",
    "playground:maco:zip": "node scripts/run-playground.mjs maco:zip",
    "playground:maco:publish": "node scripts/run-playground.mjs maco:publish",
    "cli:lint": "node --check bin/maco.mjs && node --check scripts/handoff-maco.mjs && node --check scripts/run-cli-tests.mjs && node --check scripts/run-playground.mjs",
    "cli:test": "node scripts/run-cli-tests.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm cli:lint && pnpm cli:test",
    "version:patch": "pnpm version patch",
    "prepack": "pnpm verify",
    "publish:cli": "pnpm run version:patch && pnpm verify && npm publish --access public && git push --follow-tags"
  },
  "dependencies": {
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "javascript-obfuscator": "^5.9.1",
    "rollup-plugin-obfuscator": "^1.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "3.2.7"
  },
  "bugs": {
    "url": "https://github.com/macobot/maco-game-template/issues"
  },
  "homepage": "https://github.com/macobot/maco-game-template#readme",
  "license": "UNLICENSED"
}
